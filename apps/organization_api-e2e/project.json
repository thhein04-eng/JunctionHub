{
  "name": "organization_api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["organization_api"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/organization_api-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["organization_api:build", "organization_api:serve"]
    }
  }
}
